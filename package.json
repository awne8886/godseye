{
  "name": "godseye",
  "version": "0.1.0",
  "private": true,
  "description": "GODSEYE — open-source real-time global intelligence monitor",
  "license": "MIT",
  "repository": "https://github.com/awne8886/godseye",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "node tools/prepare-map-worker.mjs && node tools/gen-mounted-routes.mjs",
    "dev": "next dev",
    "prebuild": "node tools/prepare-map-worker.mjs && node tools/gen-mounted-routes.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "RUN_LIVE_TESTS=1 vitest run",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "docs:api": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tools/ts-loader.mjs tools/gen-api-docs.ts",
    "docs:sources": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tools/ts-loader.mjs tools/compile-data-sources.ts",
    "data:airports": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tools/ts-loader.mjs tools/build-airports.ts",
    "data:routes": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tools/ts-loader.mjs tools/build-routes.ts"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@luma.gl/core": "~9.4.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "3.14.13",
    "@turf/turf": "7.4.0",
    "cmdk": "1.1.1",
    "echarts": "6.1.0",
    "h3-js": "4.5.0",
    "hls.js": "1.7.3",
    "ioredis": "6.0.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.49.0",
    "maplibre-gl": "^6.11.2",
    "minisearch": "7.2.0",
    "motion": "13.4.6",
    "next": "16.3.7",
    "nuqs": "2.10.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3",
    "react-resizable-panels": "4.14.1",
    "satellite.js": "7.1.0",
    "server-only": "0.0.1",
    "suncalc": "2.0.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/suncalc": "1.9.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.7",
    "js-yaml": "3.15.2",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "image-size": "2.0.4",
      "fflate": "^0.7.5",
      "tmp": "^0.2.6"
    }
  }
}
