# GODSEYE environment. EVERYTHING IS OPTIONAL: the app works with zero keys.
# Keys only unlock upgrades; /api/health shows which capabilities are enabled and why not.
# Never put secrets in NEXT_PUBLIC_* variables.

# ── Identity & deployment ─────────────────────────────────────────────────────
# Contact (email or URL, printable ASCII, no spaces) appended to the User-Agent sent to every upstream.
GODSEYE_CONTACT=
# Set to true on a commercial deployment: hides CC BY-NC sources (TeleGeography cables,
# Cloudflare Radar data, OpenSanctions bulk) and DeepState.
COMMERCIAL_DEPLOYMENT=
# Set to true to enable DeepStateMap frontlines (non-commercial use, attribution shown).
NONCOMMERCIAL=
# Edge platform in front of the app whose client-IP header may be trusted: cloudflare | vercel | akamai.
# Leave empty on a plain Docker deployment: the X-Forwarded-For entry appended by YOUR proxy is used.
# Never expose `next start` directly: the proxy must OVERWRITE X-Forwarded-For (Caddy:
# `header_up X-Forwarded-For {remote_host}`), or clients choose their own rate-limit bucket.
TRUSTED_PLATFORM=
# Number of trusted proxies appending to X-Forwarded-For (default 1 = the rightmost entry).
TRUSTED_PROXY_HOPS=
# Trust exactly one header your proxy OVERWRITES (e.g. x-real-ip). Overrides the above.
TRUST_PROXY_HEADER=
# HSTS `preload` commits the whole registrable domain to HTTPS; set true only if you mean it.
HSTS_PRELOAD=
# Close SSE streams after this many ms so hosts with duration caps reconnect cleanly (Vercel: 280000 default).
SSE_MAX_DURATION_MS=
# Disable the background upstream poller (tests / static preview).
GODSEYE_DISABLE_POLLER=

# ── Caching / multi-instance ──────────────────────────────────────────────────
# Redis shares caches, the single-writer lock and rate limits across instances.
REDIS_URL=
# memory | filesystem | redis (default: redis if REDIS_URL, filesystem if SNAPSHOT_DIR, else memory)
SNAPSHOT_STORE=
SNAPSHOT_DIR=

# ── Self-hostable engines (defaults are the public demo servers) ──────────────
PHOTON_URL=
NOMINATIM_URL=
VALHALLA_URL=
OSRM_URL=

# ── Aviation ──────────────────────────────────────────────────────────────────
# adsb.lol re-api (only from a feeder IP).
ADSBLOL_REAPI=
# OpenSky OAuth2 client credentials; also requires a written licence for live products.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_LICENSED=
# adsb.fi open data is for personal use only.
ADSBFI_PERSONAL_USE=
# FlightAware AeroAPI (filed routes, schedules).
AEROAPI_KEY=
# FlightPlanDatabase (flight-simulation plans only; not for real-world navigation).
FPDB_API_KEY=

# ── Space ─────────────────────────────────────────────────────────────────────
N2YO_API_KEY=

# ── Hazards & imagery ─────────────────────────────────────────────────────────
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
WAQI_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ── Maritime ──────────────────────────────────────────────────────────────────
# AISStream.io (server relay only; browsers never connect).
AIS_API_KEY=

# ── Surveillance ──────────────────────────────────────────────────────────────
WINDY_WEBCAMS_KEY=
TFL_APP_KEY=
WSDOT_ACCESS_CODE=
TRAFIKVERKET_KEY=
# IBI 511 developer keys by state, e.g. fl:KEY,ga:KEY
IBI511_KEYS=

# ── Threats / network ─────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
ACLED_EMAIL=
ACLED_PASSWORD=
UCDP_TOKEN=
ABUSECH_AUTH_KEY=
NVD_API_KEY=
OTX_KEY=
SDK_INGEST_KEY=

# ── OSINT ─────────────────────────────────────────────────────────────────────
SHODAN_KEY=
IPINFO_TOKEN=
OPENSANCTIONS_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
# Optional allow-listed scanner backend (active scans are proxied through this server).
SCANNER_URL=
SCANNER_KEY=
# Operator opt-in for active scan types (quick/vuln). Passive types only when unset.
SCANNER_ALLOW_ACTIVE=

# ── Markets ───────────────────────────────────────────────────────────────────
FINNHUB_KEY=
COINGECKO_DEMO_KEY=

# ── AI analyst (heuristic ANALYST fallback is always available) ───────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY_1=
# Operator-configured only; visitors can never supply an Ollama URL.
OLLAMA_URL=
# Set to true to refuse visitor-supplied provider keys (x-ai-key header).
DISABLE_USER_AI_KEYS=

# ── Optional standalone Photoreal City View (Google 3D Tiles; see README terms) ─
GOOGLE_MAPS_API_KEY=
