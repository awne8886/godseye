# GODSEYE environment. EVERYTHING IS OPTIONAL: the app works with zero keys.
# Keys only unlock upgrades; /api/health shows which capabilities are enabled and why not.
# Never put secrets in NEXT_PUBLIC_* variables.

# ── Identity & deployment ─────────────────────────────────────────────────────
# Contact (email or URL, printable ASCII, no spaces) appended to the User-Agent sent to every upstream.
GODSEYE_CONTACT=
# Public hostname for the bundled Caddy (docker compose): automatic HTTPS for this domain.
GODSEYE_DOMAIN=
# Set to true on a commercial deployment: turns off every non-commercial source — capability
# nc_sources (TeleGeography cables, OpenSanctions bulk, abuse.ch, ip-api, Shodan InternetDB,
# City of Edmonton cameras), openmeteo (Open-Meteo free tier), aeroapi (FlightAware AeroAPI
# personal tier), adsbfi (adsb.fi open data), cloudflare (Radar data, CC BY-NC) and deepstate.
COMMERCIAL_DEPLOYMENT=
# Set to true to enable DeepStateMap frontlines (non-commercial use, attribution shown).
NONCOMMERCIAL=
# Edge platform in front of the app whose client-IP header may be trusted: cloudflare | vercel | akamai.
# Leave empty on a plain Docker deployment: the X-Forwarded-For entry appended by YOUR proxy is used.
# Never expose `next start` directly: the proxy must OVERWRITE X-Forwarded-For (Caddy:
# `header_up X-Forwarded-For {remote_host}`), or clients choose their own rate-limit bucket.
TRUSTED_PLATFORM=
# Number of trusted proxies appending to X-Forwarded-For (default 1 = the rightmost entry).
TRUSTED_PROXY_HOPS=
# Trust exactly one header your proxy OVERWRITES (e.g. x-real-ip). Overrides the above.
TRUST_PROXY_HEADER=
# HSTS `preload` commits the whole registrable domain to HTTPS; set true only if you mean it.
HSTS_PRELOAD=
# Close SSE streams after this many ms so hosts with duration caps reconnect cleanly (Vercel: 280000 default).
SSE_MAX_DURATION_MS=
# Process-wide budget for bytes queued to slow SSE clients (default 268435456 = 256 MB).
SSE_MAX_BUFFERED_BYTES=
# Disable the background upstream poller (tests / static preview).
GODSEYE_DISABLE_POLLER=

# ── Caching / multi-instance ──────────────────────────────────────────────────
# Redis shares caches, the single-writer lock and rate limits across instances.
REDIS_URL=
# memory | filesystem | redis (default: redis if REDIS_URL, filesystem if SNAPSHOT_DIR, else memory)
SNAPSHOT_STORE=
SNAPSHOT_DIR=
# Bounds for per-query cache entries (feed snapshots are never evicted): memory bytes (default
# 256 MB) and filesystem files (default 20000).
SNAPSHOT_MEMORY_MAX_BYTES=
SNAPSHOT_MAX_FILES=
# Disk budget for per-query filesystem cache entries (default 1073741824 = 1 GB).
SNAPSHOT_MAX_DISK_BYTES=

# ── Self-hostable engines (defaults are the public demo servers) ──────────────
PHOTON_URL=
NOMINATIM_URL=
VALHALLA_URL=
OSRM_URL=

# ── Aviation ──────────────────────────────────────────────────────────────────
# adsb.lol re-api (only from a feeder IP).
ADSBLOL_REAPI=
# OpenSky OAuth2 client credentials; also requires a written licence for live products.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_LICENSED=
# adsb.fi open data is for personal use only.
ADSBFI_PERSONAL_USE=
# FlightPlanDatabase (flight-simulation plans only; not for real-world navigation).
FPDB_API_KEY=
# FlightAware AeroAPI personal tier (filed routes, schedules; non-commercial; off when
# COMMERCIAL_DEPLOYMENT=true). Sent only in the x-apikey header; 1 request per 10 s.
AEROAPI_KEY=

# ── Maritime ──────────────────────────────────────────────────────────────────
# AISStream.io (server relay only; browsers never connect).
AIS_API_KEY=

# ── Surveillance ──────────────────────────────────────────────────────────────
TFL_APP_KEY=
TRAFIKVERKET_KEY=
# Camera compliance: regions/countries shown as operator links only, and camera ids removed on request.
CCTV_LINK_OUT_ONLY=
CCTV_REMOVED_IDS=

# ── Threats / network ─────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
ABUSECH_AUTH_KEY=
NVD_API_KEY=
OTX_KEY=
SDK_INGEST_KEY=

# ── OSINT ─────────────────────────────────────────────────────────────────────
OPENSANCTIONS_KEY=
# Optional allow-listed scanner backend (active scans are proxied through this server).
SCANNER_URL=
SCANNER_KEY=
# Operator opt-in for active scan types (quick/vuln). Passive types only when unset.
SCANNER_ALLOW_ACTIVE=

# ── Markets ───────────────────────────────────────────────────────────────────
COINGECKO_DEMO_KEY=

# ── AI analyst (heuristic ANALYST fallback is always available) ───────────────
ANTHROPIC_API_KEY=
# Optional model overrides; by default each provider's model list is queried and the newest suitable model used.
ANTHROPIC_MODEL=
GEMINI_API_KEY_1=
GEMINI_MODEL=
# Operator-configured only; visitors can never supply an Ollama URL.
OLLAMA_URL=
OLLAMA_MODEL=
# Set to true to refuse visitor-supplied provider keys (x-ai-key header).
DISABLE_USER_AI_KEYS=

# ── Imports ───────────────────────────────────────────────────────────────────
# Extra ArcGIS servers /api/arcgis may import from (exact hosts, optional :port such as ArcGIS Server's
# :6443 — allowed for that host only — https only; ArcGIS Online hosted services (services.arcgis.com,
# services[1-9].arcgis.com, services-eu1/-ap1.arcgis.com) and *.arcgisonline.com are built in).
ARCGIS_ALLOWED_HOSTS=
