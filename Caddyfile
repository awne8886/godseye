# Caddy in front of GODSEYE (docker-compose.yml). Automatic HTTPS for GODSEYE_DOMAIN; with the
# default `localhost` Caddy serves its own locally trusted certificate.
# No `log` directive: Caddy writes no access log unless one is configured.
{
	admin off
}

{$GODSEYE_DOMAIN:localhost} {
	# The app ships its own CSP/HSTS/X-Frame-Options/nosniff (src/config/csp.ts); just hide the banner.
	header -Server

	# Request body caps in front of the app's own (defence in depth; Caddy answers 413 past them).
	# The analyst routes read at most 32 KiB (ai-route.ts MAX_BODY_BYTES) and the SDK ingest
	# 256 KiB (sdk.ts MAX_BODY_BYTES); no other route takes a body. Event streams are GETs and
	# unaffected. Units are decimal: 64KB = 64 000 bytes, 1MB = 1 000 000 bytes.
	@ai_body path /api/ai/*
	request_body @ai_body {
		max_size 64KB
	}
	@other_body not path /api/ai/*
	request_body @other_body {
		max_size 1MB
	}

	# Compress JSON and pages on the wire (feed JSON is 5-10x smaller gzipped). An explicit list, so
	# Server-Sent Events (text/event-stream) are never buffered by an encoder; responses the app
	# already precompressed (bulk layers, Content-Encoding set) are passed through untouched.
	encode zstd gzip {
		minimum_length 1024
		match {
			header Content-Type application/json*
			header Content-Type application/geo+json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type text/x-component*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy app:3000 {
		# OVERWRITE the client-IP headers with the address Caddy actually saw. The app keys its
		# per-route rate limits on the rightmost X-Forwarded-For entry (TRUSTED_PROXY_HOPS=1), or on
		# X-Real-IP only when TRUST_PROXY_HEADER=x-real-ip; a client-supplied value must never survive.
		# (Caddy already ignores X-Forwarded-For from untrusted clients; stating it keeps the guarantee
		# explicit if trusted_proxies is ever configured.)
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		# Server-Sent Events (/api/*/stream): forward every chunk immediately.
		flush_interval -1
	}
}
