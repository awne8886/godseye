{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3200",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 90000,
      "url": ["http://127.0.0.1:3200/"],
      "numberOfRuns": 3,
      "settings": {
        "configPath": "./tools/lighthouse/home-config.mjs",
        "pauseAfterLoadMs": 9000,
        "chromeFlags": "--headless=new --no-sandbox --enable-unsafe-swiftshader --use-angle=swiftshader --ignore-gpu-blocklist"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.45, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 13500, "aggregationMethod": "median-run" }],
        "godseye-map-globe-drawn": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
